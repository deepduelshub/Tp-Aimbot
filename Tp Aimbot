local function SaveConfig()
    local pos = Main.Position
    config.pos = {pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset}
    config.enabled = tpEnabled
    config.locked = locked
    config.settingsOpen = settingsOpen
    config.minimized = not Main.Visible
    config.theme = themeIndex
    config.bind = Bind.Text
    config.antiDieBind = AntiDieBind and AntiDieBind.Text or "None"
    config.guards.noCamShake = camShakeOn
    config.guards.antiFling = antiFlingOn
    config.guards.antiDie = antiDieOn

    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(config))
    end)
end

local function LoadConfig()
    local ok, data = pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
        return nil
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do
            if k == "guards" and type(v) == "table" then
                for gk, gv in pairs(v) do
                    config.guards[gk] = gv
                end
            else
                config[k] = v
            end
        end
    end
end

