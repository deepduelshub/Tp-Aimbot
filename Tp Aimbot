local function ApplyTheme(t)
    ChangeGui.Text = "Color Theme: " .. t.name
    UIGradient.Color = t.gradient
    Main.BackgroundColor3 = t.bgColor
    UIStroke.Color = t.stroke

    if t.useImage then
        Background.Image = t.image
        Background.Visible = true
        Background.ImageTransparency = 0.35
    else
        Background.Image = ""
        Background.Visible = false
    end

    Toggle.BackgroundColor3 = t.button
    Toggle.TextColor3 = t.text
    ChangeGui.BackgroundColor3 = t.button
    ChangeGui.TextColor3 = t.text
    Bind.BackgroundColor3 = t.button
    Bind.TextColor3 = t.text
    Hide.BackgroundColor3 = t.button
    Hide.TextColor3 = t.text
    Lock.BackgroundColor3 = t.button
    Lock.TextColor3 = t.text

    Title.TextColor3 = t.text
    Watermark.TextColor3 = t.text
    TitleStroke.Color = t.stroke

    SettingsRow.BackgroundColor3 = t.row
    SettingsLabel.TextColor3 = t.text
    SettingsArrow.TextColor3 = t.text
    SettingsAccent.BackgroundColor3 = t.accent

    for _, row in ipairs({CamShakeRow, AntiFlingRow, AntiDieRow}) do
        row.BackgroundColor3 = t.row
        local label = row:FindFirstChild("Label")
        if label then label.TextColor3 = t.text end
        local accent = row:FindFirstChild("AccentBar")
        if accent then accent.BackgroundColor3 = t.accent end
        local track = row:FindFirstChild("Track")
        if track then
            track.BackgroundColor3 = t.track
            local stroke = track:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = t.stroke end
        end
    end

    if AntiDieBind then
        AntiDieBind.BackgroundColor3 = t.button
        AntiDieBind.TextColor3 = t.text
    end
end

